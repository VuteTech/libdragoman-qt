# @VERSION@ is stamped by packaging/obs/prepare.sh from the release tag.

pkgname=libdragoman-qt
pkgver=@VERSION@
pkgrel=1
pkgdesc="Qt client library for the Dragomand translation daemon"
arch=(x86_64)
url="https://dragomand.l10n-bg.dev"
license=(GPL-3.0-or-later)
depends=(qt6-base ki18n)
makedepends=(cmake ninja extra-cmake-modules)
checkdepends=(dbus)
optdepends=('dragomand: the translation daemon this library talks to')
provides=(libdragoman-qt.so)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
