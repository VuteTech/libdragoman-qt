@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6Core @QT_MIN_VERSION@)
find_dependency(Qt6DBus @QT_MIN_VERSION@)
find_dependency(KF6I18n @KF_MIN_VERSION@)

include("${CMAKE_CURRENT_LIST_DIR}/DragomanQtTargets.cmake")

# The fake daemon for autotests: a header-only helper that needs Qt6::Test.
set(DragomanQt_TESTING_INCLUDE_DIR "@PACKAGE_KDE_INSTALL_INCLUDEDIR@/DragomanQt/testing")
